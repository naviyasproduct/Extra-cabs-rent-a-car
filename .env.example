# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored. Never commit a token.
# On Vercel these go in Project Settings, Environment Variables.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# The real domain, no trailing slash. Every canonical, sitemap entry, Open
# Graph tag and JSON-LD URL is built from this. Falls back to
# https://extracabs.lk, which is a guess.
NEXT_PUBLIC_SITE_URL=https://extracabs.lk

# ---------------------------------------------------------------------------
# Text.lk SMS gateway
# ---------------------------------------------------------------------------
# Booking alerts to the owner and staff. See docs/sms.md for the setup steps
# and https://text.lk/docs/send-sms/ for the API.

# Dashboard, Developers, API Tokens. Starts with a long random string.
# This is a secret: it can spend the account's SMS credit.
TEXTLK_API_TOKEN=

# The name the text appears to come from. Max 11 characters, no spaces. Must be
# registered and approved under Sending, Sender ID in the dashboard before it
# will work on real traffic. TextLKDemo is their sandbox sender, testing only.
#
# Currently zsensu.com, the developer's own approved sender ID, lent to this
# deployment rather than registered to the agency. See docs/sms.md section 2b.
TEXTLK_SENDER_ID=zsensu.com

# Set to false to stop all outbound SMS without removing the credentials.
# Useful on preview deployments, where real texts to the owner are just noise.
SMS_ENABLED=true

# ---------------------------------------------------------------------------
# Supabase (Postgres, Auth, and the private id-documents bucket)
# ---------------------------------------------------------------------------
# Project Settings, API. The project is in ap-south-1 (Mumbai); deploy Vercel
# functions to bom1 so they sit next to it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Both bypass every access rule. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Used to push migrations (supabase db push --db-url ...). Not needed at runtime.
SUPABASE_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Cloudinary (vehicle photos only; ID documents never go here)
# ---------------------------------------------------------------------------
# Dashboard, Settings, API Keys. Without these the panel says photo uploads
# are not configured and vehicles show a placeholder tile.

# Public by design: it appears in every delivery URL, so the browser needs it.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# SERVER ONLY. Signs every upload and delete, so the secret never reaches the
# browser and nobody can upload into the account from the page JavaScript.
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Panel secrets
# ---------------------------------------------------------------------------
# SERVER ONLY. Mixed into every write-window code hash. REQUIRED in production:
# the app refuses to issue codes with the public development fallback.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PANEL_OTP_PEPPER=

# SERVER ONLY. Protects /api/cron/retention (the daily ID-photo retention run
# scheduled in vercel.json). Vercel sends it as "Authorization: Bearer ...".
# Without it the route refuses to run. Generate the same way as the pepper.
CRON_SECRET=
