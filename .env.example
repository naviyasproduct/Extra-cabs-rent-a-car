# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored. Never commit a token.
# On Vercel these go in Project Settings, Environment Variables.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# The real domain, no trailing slash. Every canonical, sitemap entry, Open
# Graph tag and JSON-LD URL is built from this. Falls back to
# https://extracabs.lk, which is a guess.
NEXT_PUBLIC_SITE_URL=https://extracabs.lk

# ---------------------------------------------------------------------------
# Text.lk SMS gateway
# ---------------------------------------------------------------------------
# Booking alerts to the owner and staff. See docs/sms.md for the setup steps
# and https://text.lk/docs/send-sms/ for the API.

# Dashboard, Developers, API Tokens. Starts with a long random string.
# This is a secret: it can spend the account's SMS credit.
TEXTLK_API_TOKEN=

# The name the text appears to come from. Max 11 characters, letters and
# digits, no spaces. Must be registered and approved under Sending, Sender ID
# in the dashboard before it will work on real traffic.
# TextLKDemo is their sandbox sender and is for testing only.
TEXTLK_SENDER_ID=ExtraCabs

# Set to false to stop all outbound SMS without removing the credentials.
# Useful on preview deployments, where real texts to the owner are just noise.
SMS_ENABLED=true
